---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';

const links = [
  { label: 'GitHub', href: site.social.github },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'Twitter / X', href: site.social.twitter },
  { label: 'Email', href: `mailto:${site.email}` },
];
---

<BaseLayout title="Social" description="Find João Farias on the web.">
  <section class="container-prose py-12">
    <h1 class="text-4xl font-bold tracking-tight">Social</h1>
    <ul class="mt-8 space-y-3">
      {links.map((l) => (
        <li><a href={l.href} class="text-lg text-accent hover:underline">{l.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
