---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Map<string, typeof posts>();
  for (const p of posts) {
    for (const t of p.data.tags) {
      if (!tags.has(t)) tags.set(t, []);
      tags.get(t)!.push(p);
    }
  }
  return [...tags.entries()].map(([tag, items]) => ({
    params: { tag },
    props: {
      tag,
      posts: items.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`}>
  <section class="container-prose py-12">
    <h1 class="text-3xl font-bold tracking-tight mb-1">#{tag}</h1>
    <p class="text-ink-500 dark:text-ink-400 mb-6">{posts.length} posts</p>
    {posts.map((p) => <PostCard post={p} />)}
  </section>
</BaseLayout>
