---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';
---

<BaseLayout title="About" description={`About ${site.author}`}>
  <section class="container-prose py-12">
    <h1 class="text-4xl font-bold tracking-tight">About</h1>
    <div class="prose dark:prose-invert mt-6">
      <p class="text-xl">
        Making educated guesses based on unreliable data provided by people who
        don't know what they want.
      </p>
      <p>
        I'm <strong>{site.author}</strong>. <em>That's a Bug</em> is where I write
        about software testing, the craft of building things that survive contact
        with reality, and the messy reality of doing both at the same time.
      </p>
      <p>
        The blog has been running since 2018. The focus is widening — testing
        strategy and dev practices stay at the core, with portfolio work and
        (soon) courses and digital resources for engineers who want to take
        software quality seriously.
      </p>
      <h2>Find me</h2>
      <ul>
        <li><a href={site.social.github}>GitHub</a></li>
        <li><a href={site.social.linkedin}>LinkedIn</a></li>
        <li><a href={site.social.twitter}>Twitter</a></li>
        <li><a href={`mailto:${site.email}`}>Email</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
