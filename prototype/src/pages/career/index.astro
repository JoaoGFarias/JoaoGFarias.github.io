---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';

const entries = (await getCollection('career'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Career" description="Roles, responsibilities, and what I shipped along the way.">
  <section class="container-wide py-12">
    <header class="max-w-2xl mb-12">
      <h1 class="text-4xl font-bold tracking-tight">Career</h1>
      <p class="mt-4 text-ink-600 dark:text-ink-300">
        Roles, responsibilities, and what I shipped along the way. Newest first.
      </p>
    </header>

    <div class="space-y-4">
      {entries.map((entry) => (
        <a
          href={`/career/${entry.id.replace(/\.md$/, '')}/`}
          class="group block p-6 rounded-lg border border-ink-200 dark:border-ink-800 hover:border-accent transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <h2 class="text-xl font-bold tracking-tight group-hover:text-accent transition-colors">
              {entry.data.title}
            </h2>
            <p class="text-sm text-ink-500 dark:text-ink-400 sm:text-right shrink-0">
              {entry.data.period}
            </p>
          </div>
          <p class="mt-3 text-ink-600 dark:text-ink-300 leading-relaxed">
            {entry.data.summary}
          </p>
          {entry.data.stack.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {entry.data.stack.map((s) => (
                <span class="rounded bg-ink-100 dark:bg-ink-800 px-2 py-0.5 text-xs">{s}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
