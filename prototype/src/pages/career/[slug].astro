---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('career');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'career'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, role, company, period, stack, link } = entry.data;
---

<BaseLayout title={title}>
  <article class="container-prose py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
      <p class="mt-3 text-ink-500 dark:text-ink-400">
        {role}{company && ` · ${company}`} · {period}
      </p>
      {stack.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {stack.map((s) => (
            <span class="rounded bg-ink-100 dark:bg-ink-800 px-2 py-0.5 text-xs">{s}</span>
          ))}
        </div>
      )}
      {link && (
        <a href={link} class="mt-4 inline-block text-accent hover:underline">
          Visit project →
        </a>
      )}
    </header>
    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
