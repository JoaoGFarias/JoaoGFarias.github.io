---
import { site } from '~/site.config';

const author = {
  name: site.author,
  avatar: '/assets/bio-photo.jpg',
  bio: "Making educated guesses based on unreliable data provided by people who don't know what they want.",
};

const followLinks = [
  { label: 'Twitter', href: site.social.twitter },
  { label: 'LinkedIn', href: site.social.linkedin },
];
---

<section class="rounded-lg border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-5 py-4">
  <div class="flex items-center gap-4">
    <img
      src={author.avatar}
      alt={author.name}
      class="h-12 w-12 rounded-full object-cover flex-shrink-0"
      loading="lazy"
    />
    <div class="flex-1 min-w-0">
      <p class="font-bold text-ink-900 dark:text-ink-50">{author.name}</p>
      <p class="text-sm text-ink-600 dark:text-ink-300 leading-snug">{author.bio}</p>
    </div>
    <div class="hidden sm:flex items-center gap-2">
      {followLinks.map((l) => (
        <a
          href={l.href}
          class="inline-flex items-center rounded border border-ink-300 dark:border-ink-700 px-3 py-1.5 text-sm font-medium hover:border-accent hover:text-accent transition-colors">
          {l.label}
        </a>
      ))}
    </div>
  </div>
</section>
