---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const href = `/blog/${post.slug}/`;
---

<article class="group py-6 border-b border-ink-100 dark:border-ink-800 last:border-0">
  <a href={href} class="block">
    <h2 class="text-2xl font-bold tracking-tight group-hover:text-accent transition-colors">
      {post.data.title}
    </h2>
    <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-ink-500 dark:text-ink-400">
      <FormattedDate date={post.data.date} />
      {post.data.tags.length > 0 && (
        <span class="flex flex-wrap gap-2">
          {post.data.tags.slice(0, 4).map((t) => (
            <span class="rounded bg-ink-100 dark:bg-ink-800 px-2 py-0.5 text-xs">
              #{t}
            </span>
          ))}
        </span>
      )}
    </div>
    {post.data.excerpt && (
      <p class="mt-3 text-ink-600 dark:text-ink-300 leading-relaxed">
        {post.data.excerpt}
      </p>
    )}
  </a>
</article>
